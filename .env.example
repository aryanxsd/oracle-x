# ORACLE X — environment template. Copy to .env.local and fill in. Never commit real values.
# All variables are read server-side only (lib/snowflake.ts).

# Option A: use a named connection from ~/.snowflake/connections.toml (local development)
SNOWFLAKE_CONNECTION_NAME=
# SNOWFLAKE_HOME=

# Option B: explicit connection settings
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_HOST=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Session context
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Optional driver settings
# SNOWFLAKE_SDK_DISABLE_OCSP=
# SNOWFLAKE_SDK_QUIET=

# Public read-only mode: "true" refuses council / scenario / agent actions with 403 and hides their buttons.
ORACLE_X_READ_ONLY=
